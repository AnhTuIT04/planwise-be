# Application configuration
PORT="8080"
WS_PORT="8181"
DOMAIN="localhost"
CORS_ORIGIN="http://localhost:3000"

# Authentication configuration
JWT_SECRET="your_jwt_secret_key"
JWT_ACCESS_TOKEN_EXPIRATION="15m"
EMAIL_VERIFIER_USER="your_email_verifier_user"
EMAIL_VERIFIER_PASS="your_email_verifier_pass"

# Database & Cache configuration
POSTGRES_DATABASE_URL="postgresql://username:password@localhost:5432/planwise"
MONGODB_DATABASE_URL="mongodb://localhost:27017/planwise"
REDIS_URL="redis://localhost:6379"

# OAuth configuration
OAUTH_SUCCESS_REDIRECT_URL="${CORS_ORIGIN}/oauth/success"

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_OAUTH_CLIENT_SECRET="your_google_oauth_client_secret"
GOOGLE_OAUTH_CALLBACK_URL="http://localhost:8080/api/v1/auth/google/callback"

# GitHub OAuth  
GITHUB_OAUTH_CLIENT_ID="your_github_oauth_client_id"
GITHUB_OAUTH_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_OAUTH_CALLBACK_URL="http://localhost:8080/api/v1/auth/github/callback"

# Integration configuration
INTEGRATION_SUCCESS_REDIRECT_URL="${CORS_ORIGIN}/my-tasks"
WEBHOOK_BASE_URL="https://yourdomain.com/api/v1/webhooks" # https url which points to your backend

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID="your_google_calendar_client_id"
GOOGLE_CALENDAR_CLIENT_SECRET="your_google_calendar_client_secret"
GOOGLE_CALENDAR_REDIRECT_URL="http://localhost:8080/api/v1/integrations/callback"

# Google Mail OAuth
GOOGLE_GMAIL_CLIENT_ID="your_google_gmail_client_id"
GOOGLE_GMAIL_CLIENT_SECRET="your_google_gmail_client_secret"
GOOGLE_GMAIL_REDIRECT_URL="http://localhost:8080/api/v1/integrations/callback"

# AI Configuration
GEMINI_API_KEY="your_gemini_api_key"

# Admin
ADMIN_JWT_SECRET="your_admin_jwt_secret_key"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your_admin_password"
