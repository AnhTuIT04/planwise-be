{
  "name": "planwise-be",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc && tsc-alias",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "cross-env NODE_ENV=production node -r tsconfig-paths/register dist/main.js",
    "start:dev": "cross-env NODE_ENV=development nodemon --watch src --ext ts,js,mjs,cjs,json --exec \"ts-node -r tsconfig-paths/register src/main.ts\"",
    "start:debug": "cross-env NODE_ENV=development nodemon --watch src --ext ts,js,mjs,cjs,json --exec \"node --inspect -r ts-node/register -r tsconfig-paths/register src/main.ts\"",
    "start:prod": "cross-env NODE_ENV=production node -r tsconfig-paths/register dist/main.js",
    "pg:gen": "prisma generate --schema prisma/pg.schema.prisma",
    "pg:migrate": "prisma migrate dev --schema prisma/pg.schema.prisma",
    "pg:push": "prisma db push --schema prisma/pg.schema.prisma",
    "pg:reset": "prisma migrate reset --schema prisma/pg.schema.prisma",
    "pg:studio": "prisma studio --schema prisma/pg.schema.prisma",
    "pg:seed-review": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/scripts/seed-review.ts",
    "pg:seed-notifications": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/scripts/seed-notifications.ts",
    "pg:seed-demo": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/scripts/seed-demo.ts",
    "pg:seed-admin": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/scripts/seed-admin.ts",
    "mongo:gen": "prisma generate --schema prisma/mongo.schema.prisma",
    "mongo:push": "prisma db push --schema prisma/mongo.schema.prisma",
    "mongo:reset": "prisma db push --force-reset --schema prisma/mongo.schema.prisma",
    "mongo:studio": "prisma studio --schema prisma/mongo.schema.prisma",
    "db:gen": "npm run pg:gen && npm run mongo:gen",
    "db:push": "npm run pg:push && npm run mongo:push",
    "db:setup": "npm run db:gen && npm run db:push",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^11.1.19",
    "@notionhq/client": "^5.20.0",
    "@prisma/client": "6.19",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.5",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.1.19",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jest": "^30.4.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prisma": "6.19",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "path-to-regexp": "^8.3.1"
  }
}
