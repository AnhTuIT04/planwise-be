generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  password        String?
  fullname        String
  avatarUrl       String?
  verified        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  comments        Comment[]
  accounts        OAuthAccount[]
  projects        Project[]
  supervisedTasks Task[]
  tasks           TaskOfUser[]
}

enum Provider {
  google
  github
}

model OAuthAccount {
  id       String   @id @default(uuid())
  provider Provider
  userId   String
  own      User     @relation(fields: [userId], references: [id])
}

model Project {
  id            String    @id @default(uuid())
  name          String
  logoUrl       String?
  description   String?
  isPersonal    Boolean   @default(false)
  listOfSection String    @default("")
  createdAt     DateTime  @default(now())
  owner         String
  own           User      @relation(fields: [owner], references: [id])
  sections      Section[]
  tasks         Task[]
}

model Section {
  id         String          @id @default(uuid())
  name       String
  listOfTask String          @default("")
  createdAt  DateTime        @default(now())
  projectId  String
  has        Project         @relation(fields: [projectId], references: [id])
  tasks      TaskOfSection[]
}

model Task {
  id               String          @id @default(uuid())
  title            String
  description      String?
  status           TaskStatus      @default(TODO)
  priority         PriorityLevel   @default(NORMAL)
  startDate        DateTime?
  dueDate          DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  parentTaskId     String?
  supervisorId     String?
  projectId        String
  comments         Comment[]
  parent           Task?           @relation("SubtasksRelation", fields: [parentTaskId], references: [id])
  subtasks         Task[]          @relation("SubtasksRelation")
  belongsToProject Project         @relation(fields: [projectId], references: [id])
  supervisor       User?           @relation(fields: [supervisorId], references: [id])
  assignees        TaskOfUser[]
  sections         TaskOfSection[]
}

model TaskOfUser {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model TaskOfSection {
  taskId    String
  sectionId String
  task      Task    @relation(fields: [taskId], references: [id])
  section   Section @relation(fields: [sectionId], references: [id])

  @@id([taskId, sectionId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
  taskId    String
  author    User     @relation(fields: [authorId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  DELAYED
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}
