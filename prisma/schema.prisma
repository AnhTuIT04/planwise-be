generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String?
  fullname    String
  avatarUrl   String?
  verified    Boolean  @default(false)
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  oauthAccounts   OAuthAccount[]
  ownedProjects   Project[]           @relation("UserOwnsProjects")
  invitations     ProjectInvitation[]
  memberships     ProjectMember[]     @relation("UserProjectMemberships")
  supervisedTasks Task[]              @relation("TaskSupervisor")
  assignedTasks   TaskAssignee[]
  comments        Comment[]
}

enum AuthProvider {
  GOOGLE
  GITHUB
}

model OAuthAccount {
  id       String       @id @default(uuid())
  provider AuthProvider

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, provider])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  description String?
  isPersonal  Boolean  @default(false)
  createdAt   DateTime @default(now())

  sections      Section[]
  tasks         TaskProject[]
  originalTasks Task[]              @relation("OriginalProjectTasks")
  members       ProjectMember[]     @relation("ProjectHasMembers")
  roles         Role[]
  invitations   ProjectInvitation[]

  owner   User   @relation("UserOwnsProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String
}

model Section {
  id        String   @id @default(uuid())
  name      String
  position  String
  createdAt DateTime @default(now())

  tasks TaskSection[]

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
}

model Task {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      TaskStatus    @default(TODO)
  priority    PriorityLevel @default(NORMAL)
  estimate    Int           @default(1200000) // 20 minutes in milliseconds
  spent       Int           @default(0) // in milliseconds
  lastStarted DateTime?
  deadline    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  projects TaskProject[]
  sections TaskSection[]

  assignees TaskAssignee[]
  comments  Comment[]

  originalProject   Project @relation("OriginalProjectTasks", fields: [originalProjectId], references: [id], onDelete: Cascade)
  originalProjectId String

  subtasks     Task[]  @relation("TaskSubtasks")
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  parentTaskId String?

  supervisor   User?   @relation("TaskSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisorId String?
}

model TaskProject {
  taskId    String
  projectId String

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([taskId, projectId])
}

model TaskSection {
  taskId    String
  sectionId String
  position  String

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([taskId, sectionId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
}

enum TaskStatus {
  TODO
  RUNNING
  DONE
  ARCHIVED
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ProjectInvitation {
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  inviter   User   @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@id([inviterId, projectId])
}

model ProjectMember {
  userId    String
  projectId String
  roleId    String

  user    User    @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation("ProjectHasMembers", fields: [projectId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model Role {
  id          String  @id @default(uuid())
  name        String
  permissions String  @default("[]")
  default     Boolean @default(false)

  members ProjectMember[]

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@unique([name, projectId])
}
