// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String?
  avatarUrl String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        OAuthAccount[]
  projects        Project[]
  supervisedTasks Task[]
  tasks           TaskOfUser[] // Tasks were assigned to the user
  comments        Comment[]
}

enum Provider {
  google
  github
}

model OAuthAccount {
  id       String   @id @default(uuid())
  provider Provider

  own    User   @relation(fields: [userId], references: [id])
  userId String
}

model Project {
  id            String   @id @default(uuid())
  name          String
  description   String?
  isPersonal    Boolean  @default(false)
  listOfSection String   @default("[]") // Storing section IDs as a JSON array, to define their order
  createdAt     DateTime @default(now())

  sections Section[]
  tasks    Task[]

  own   User   @relation(fields: [owner], references: [id])
  owner String
}

model Section {
  id         String   @id @default(uuid())
  name       String
  listOfTask String   @default("[]") // Storing task IDs as a JSON array, to define their order
  createdAt  DateTime @default(now())

  has       Project @relation(fields: [projectId], references: [id])
  projectId String
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  DELAYED
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id          String         @id @default(uuid())
  title       String
  description String?
  status      TaskStatus     @default(TODO)
  // createdBy   String // User ID of the creator, dont need a relation here
  priority    PriorityLevel?
  startDate   DateTime?
  dueDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  sectionId String // Section ID to which the task belongs, doesnt need a relation here

  assignees TaskOfUser[]
  subtasks  Task[]       @relation("SubtasksRelation")
  comments  Comment[]

  parent       Task?   @relation("SubtasksRelation", fields: [parentTaskId], references: [id])
  parentTaskId String?

  supervisor   User?   @relation(fields: [supervisorId], references: [id])
  supervisorId String?

  belongsToProject Project @relation(fields: [projectId], references: [id])
  projectId        String
}

model TaskOfUser {
  task   Task   @relation(fields: [taskId], references: [id])
  taskId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@id([taskId, userId]) // Composite primary key
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  task   Task   @relation(fields: [taskId], references: [id])
  taskId String
}
