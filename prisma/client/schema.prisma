generator client {
  provider = "prisma-client-js"
  output   = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  fullname  String
  avatarUrl String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           OAuthAccount[]
  ownedProjects      Project[]           @relation("UserOwnsProjects")
  projectInvitations ProjectInvitation[]
  projectMemberships UserInProject[]     @relation("UserProjectMemberships")
  supervisedTasks    Task[]              @relation("SupervisorTasks")
  tasks              TaskOfUser[]
  comments           Comment[]
}

enum Provider {
  google
  github
}

model OAuthAccount {
  id       String   @id @default(uuid())
  provider Provider

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Project {
  id            String   @id @default(uuid())
  name          String
  logoUrl       String?
  description   String?
  isPersonal    Boolean  @default(false)
  listOfSection String   @default("[]")
  createdAt     DateTime @default(now())

  sections    Section[]
  invitations ProjectInvitation[]
  memberships UserInProject[]     @relation("ProjectHasMembers")
  roles       Role[]

  owner   User?   @relation("UserOwnsProjects", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?
}

model Section {
  id         String   @id @default(uuid())
  name       String
  listOfTask String   @default("[]")
  createdAt  DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  tasksOfSection TaskOfSection[]
}

model Task {
  id           String         @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus     @default(TODO)
  priority     PriorityLevel?
  timeEstimate Int            @default(20)
  timeSpent    Int            @default(0)
  lastStarted  DateTime?
  deadline     DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // TODO: double check assignees between task and subtasks
  assignees      TaskOfUser[]
  subtasks       Task[]          @relation("SubtasksRelation")
  comments       Comment[]
  tasksOfSection TaskOfSection[]

  // TODO: missing project relation

  parent       Task?   @relation("SubtasksRelation", fields: [parentTaskId], references: [id], onDelete: Cascade)
  parentTaskId String?

  supervisor   User?   @relation("SupervisorTasks", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisorId String?
}

model TaskOfUser {
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([taskId, userId])
}

model TaskOfSection {
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String

  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String

  @@id([taskId, sectionId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  mediaUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
}

enum TaskStatus {
  TODO
  RUNNING
  DONE
  ARCHIVED
}

enum PriorityLevel {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ProjectInvitation {
  status    InvitationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  inviter   User   @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId String

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@id([inviterId, projectId])
}

model UserInProject {
  user   User   @relation("UserProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  project   Project @relation("ProjectHasMembers", fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  @@id([userId, projectId])
}

model Role {
  id               String  @id @default(uuid())
  name             String
  listOfPermission String  @default("[]")
  isDefault        Boolean @default(false)

  userInProjects UserInProject[]

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  @@unique([name, projectId])
}
