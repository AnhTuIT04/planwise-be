generator MongoClient {
  provider = "prisma-client-js"
  output   = "client/mongo"
}

datasource mongo {
  provider = "mongodb"
  url      = env("MONGODB_DATABASE_URL")
}

enum ContentType {
  TEXT
  IMAGE
  VIDEO
  FILE
}

model Message {
  id String @id @default(auto()) @map("_id") @mongo.ObjectId

  channelId String
  senderId  String

  content     String
  contentType ContentType
  createdAt   DateTime    @default(now())

  @@index([channelId, createdAt(sort: Desc)])
}

model VoiceSession {
  id String @id @default(auto()) @map("_id") @mongo.ObjectId

  channelId String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  participants String[]
}

model VideoCall {
  id String @id @default(auto()) @map("_id") @mongo.ObjectId

  channelId String

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  participants String[]
}
